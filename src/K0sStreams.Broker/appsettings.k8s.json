{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenTelemetry": {
    "OtlpEndpoint": "http://jaeger.demo-observability.svc.cluster.local:14250"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:9090",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:9091",
        "Protocols": "Http2"
      }
    }
  },
  "Retention": {
    "MaxAge": "24:00:00",
    "MaxBytes": 1073741824,
    "CheckInterval": "00:05:00"
  },
  "Replication": {
    "Peers": {
      "broker-0": "http://broker-0.broker:9091",
      "broker-1": "http://broker-1.broker:9091",
      "broker-2": "http://broker-2.broker:9091"
    },
    "RpcTimeout": "00:00:02",
    "HeartbeatInterval": "00:00:00.500",
    "RetryBackoff": "00:00:00.100",
    "MaxRetryBackoff": "00:00:02",
    "MaxBatchRecords": 500,
    "MaxBatchBytes": 1048576
  },
  "Coordination": {
    "LeaseName": "k0sstreams-leader",
    "LeaseDuration": "00:00:10",
    "RenewDeadline": "00:00:07",
    "RetryPeriod": "00:00:02",
    "LeaderAddressFormat": "http://{0}.broker:9090"
  },
  "Broker": {
    "DataDir": "/data"
  }
}