<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Trae las abstracciones de ILogger sin agregar un paquete nuevo ni tocar
         Directory.Packages.props, que es compartido. Mismo camino que K0sStreams.Replication. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Configuration.Abstractions y DependencyInjection.Abstractions ya vienen con el
         FrameworkReference de arriba: referenciarlos aparte es redundante (NU1510). -->
    <PackageReference Include="System.IO.Hashing" />
    <ProjectReference Include="../K0sStreams.Contracts/K0sStreams.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="K0sStreams.Storage.Tests" />
  </ItemGroup>

</Project>
